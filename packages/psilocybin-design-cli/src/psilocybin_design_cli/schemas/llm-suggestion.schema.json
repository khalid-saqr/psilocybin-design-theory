{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Psilocybin LLM Suggestion",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "suggestions",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "target_path",
          "value",
          "confidence",
          "evidence",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "add",
              "update",
              "replace"
            ]
          },
          "target_path": {
            "type": "string"
          },
          "value": {},
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}